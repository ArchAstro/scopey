{
  "schema_version": 1,
  "id": "query-preserves-active-work",
  "category": "query",
  "description": "A status question adds a read-only obligation without authorizing extra implementation.",
  "turns": [
    {
      "user": "Implement retry backoff for uploads and add unit tests.",
      "expect": {
        "operations": ["ADD"],
        "must_include": [["retry"], ["backoff"], ["upload"], ["unit test", "unit tests"]],
        "must_exclude": []
      }
    },
    {
      "user": "Before continuing, what files would this touch? Don't edit anything yet.",
      "expect": {
        "operations": ["QUERY"],
        "must_include": [["retry"], ["backoff"], ["upload"], ["unit test", "unit tests"], ["what files", "which files", "files affected", "files would"], ["don't edit", "do not edit", "no edits", "read-only"]],
        "must_exclude": [["commit"], ["deploy"]]
      }
    }
  ]
}
